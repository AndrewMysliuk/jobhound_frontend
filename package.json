{
  "name": "jobhound-frontend",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nuxt build",
    "serve": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check \"app/**/*.{vue,ts,tsx,jsx,js,scss,css}\" \"*.ts\"",
    "lint:fix": "ESLINT_MODE=strict eslint app \"*.ts\" \"nuxt.config.ts\" --no-error-on-unmatched-pattern --fix",
    "lint:eslint": "ESLINT_MODE=light eslint app \"*.ts\" \"nuxt.config.ts\" --no-error-on-unmatched-pattern",
    "lint:eslint:strict": "ESLINT_MODE=strict eslint app \"*.ts\" \"nuxt.config.ts\" --no-error-on-unmatched-pattern --max-warnings 0",
    "lint:ci": "pnpm typecheck && pnpm lint:eslint:strict",
    "lint-staged": "lint-staged",
    "typecheck": "nuxt typecheck",
    "gen:api-error-codes": "node --experimental-strip-types scripts/gen-api-error-codes.ts",
    "check:api-error-codes": "sh scripts/check-api-error-codes-sync.sh",
    "check:api-response": "vitest run --config vitest.unit.config.ts app/__tests__/unit/ci/api-response-hygiene.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "date-fns": "^4.1.0",
    "inputmask": "^5.0.9",
    "nuxt": "^4.2.1",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/inputmask": "^5.0.7",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.5.0",
    "happy-dom": "^20.13.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.5.3",
    "sass": "^1.89.2",
    "tailwindcss": "^4.1.12",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.1.6"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "@vue/eslint-config-typescript>@typescript-eslint/eslint-plugin": "^8.26.1",
      "@vue/eslint-config-typescript>@typescript-eslint/parser": "^8.26.1"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "env ESLINT_MODE=strict eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{scss,css,json}": [
      "prettier --write"
    ]
  }
}
